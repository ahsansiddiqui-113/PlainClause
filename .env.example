# --- Database ---
# Production / hosted: your Neon connection string.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Local development with NO hosted database (in-process Postgres, migrations auto-applied):
# DATABASE_URL=pglite://.pglite

# --- AI (Gemini via Vercel AI SDK) ---
# Use a paid-tier key in production: the free tier may use inputs to improve Google products.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override (default gemini-3.5-flash). gemini-2.5-flash is closed to new keys.
# GEMINI_MODEL=gemini-3.5-flash

# --- Auth (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public URL of the site (no trailing slash). Locally: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Google sign-in. Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to show the "Continue with Google" button (requires the two values above).
NEXT_PUBLIC_GOOGLE_ENABLED=false

# --- Site ---
NEXT_PUBLIC_CONTACT_EMAIL=support@plainclause.example

# --- Billing (Lemon Squeezy) ---
# Checkout returns 503 until the first four are set. Create a store, two subscription variants
# (monthly $8, annual $59), an API key, and a webhook pointing at <site>/api/webhooks/billing
# with the events subscription_* enabled. Use test mode first.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_ANNUAL=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true

# --- Email (Resend) + deadline-alert cron ---
# With RESEND_API_KEY and EMAIL_FROM set, sign-up requires email verification and the cron can send.
# EMAIL_FROM must be an address on a domain verified in Resend, e.g. PlainClause <alerts@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=
# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to /api/cron/deadline-alerts (daily, vercel.json)
CRON_SECRET=

# --- Ads (Google AdSense) ---
# Leave NEXT_PUBLIC_ADSENSE_CLIENT empty to disable ads and the cookie banner entirely.
# Fill in after AdSense approves the site (Day 20). Slot ids come from Ads > By ad unit.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=

# --- Monitoring (all optional; leave empty to disable) ---
# Sentry: errors only (no tracing, replay, cookies or request bodies are ever sent).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed to upload source maps at build time:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# PostHog: cookieless pageviews + a few feature events.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
